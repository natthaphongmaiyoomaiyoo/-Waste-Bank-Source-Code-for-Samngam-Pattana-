# Supabase pooled runtime URL and direct migration URL (never commit real values)
# DATABASE_URL must use the transaction pooler: port 6543 plus
# ?pgbouncer=true&connection_limit=5&connect_timeout=15&pool_timeout=20.
# Session mode (5432) caps a project at 15 clients and Prisma opens
# (CPU cores x 2 + 1) per process, so it runs out. The timeouts cover the ~1 s
# round trip to the hosted pooler, which Prisma's 5 s connect default can miss.
# DIRECT_URL stays on 5432 - migrations need a session connection.
DATABASE_URL=
DIRECT_URL=

# Server
PORT=4000
# Set HOST=127.0.0.1 in production so the API is reachable only through nginx.
# HOST=
NODE_ENV=development

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS - the Quasar frontend dev server
CORS_ORIGIN="http://localhost:9000"

# Base URL this server is reachable at - used to build absolute /uploads/... image URLs
PUBLIC_BASE_URL="http://localhost:4000"

# File storage. Remote (default): Supabase Storage - SUPABASE_URL and the
# service role key are required in production, and the key belongs in the
# backend only.
# Local: set SUPABASE_STORAGE_REMOTE=false and, in production, STORAGE_LOCAL_ROOT
# to a directory outside the deployed code (e.g. /var/www/vhosts/<domain>/storage).
# Public buckets are served from /uploads/<bucket>/; member and sale documents
# only through signed links that expire after 10 minutes.
SUPABASE_STORAGE_REMOTE=true
# STORAGE_LOCAL_ROOT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_NEWS=news
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_VIDEOS=videos
SUPABASE_STORAGE_BUCKET_MEMBER_DOCUMENTS=member-documents
SUPABASE_STORAGE_BUCKET_SALE_DOCUMENTS=sale-documents

# Dedicated disposable PostgreSQL URLs for integration tests. Both URLs must
# explicitly include schema=wastebank_test; never point these at schema=public.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# CO2 credit estimation for sold/exported waste only.
# CO2_CREDIT_DEFAULT_FACTOR=0.7
# CO2_CREDIT_WASTE_TYPE_FACTORS_JSON='{"ขวดพลาสติก PET":1.2,"กระดาษลัง":0.9,"1":1.2}'
